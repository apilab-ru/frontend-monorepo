{
  "name": "filecab-popup",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/filecab/popup/src",
  "prefix": "popup",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "outputPath": {
          "base": "apps/filecab/dist/popup",
          "browser": ""
        },
        "index": "apps/filecab/popup/src/index.html",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/filecab/popup/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/filecab/popup/src/wish-list-icon.png",
          "apps/filecab/popup/src/assets",
          {
            "glob": "*.svg",
            "input": "apps/filecab/shared/popup-add-item/components/founded-item/images",
            "output": "assets/popup-add-item"
          }
        ],
        "styles": ["apps/filecab/popup/src/styles.scss"],
        "optimization": {
          "scripts": true,
          "styles": {
            "minify": false,
            "inlineCritical": false
          },
          "fonts": true
        },
        "scripts": [],
        "browser": "apps/filecab/popup/src/main.ts",
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        }
      },
      "configurations": {
        "production": {
          "baseHref": "./index.html?/",
          "fileReplacements": [
            {
              "replace": "apps/filecab/popup/src/environments/environment.ts",
              "with": "apps/filecab/popup/src/environments/environment.production.ts"
            }
          ],
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "none",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true
        },
        "development": {
          "baseHref": "./",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "browser": {
          "baseHref": "",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/filecab/popup/src/environments/environment.ts",
              "with": "apps/filecab/popup/src/environments/environment.browser.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "browser",
      "continuous": true,
      "configurations": {
        "production": {
          "buildTarget": "filecab-popup:build:production"
        },
        "development": {
          "buildTarget": "filecab-popup:build:development"
        },
        "browser": {
          "buildTarget": "filecab-popup:build:browser",
          "proxyConfig": "apps/filecab/popup/src/proxy.conf.json",
          "ssl": true,
          "allowedHosts": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "filecab-popup:build:development",
        "port": 6006,
        "configDir": "apps/filecab/shared/.storybook",
        "tsConfig": "apps/filecab/shared/.storybook/tsconfig.json",
        "styles": ["apps/filecab/shared/.storybook/global.scss"],
        "compodoc": false,
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "sourceMap": false,
        "assets": [
          {
            "glob": "*.svg",
            "input": "apps/filecab/shared/popup-add-item/components/founded-item/images",
            "output": "assets/popup-add-item"
          }
        ]
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "browserTarget": "filecab-popup:build:development",
        "configDir": "apps/filecab/shared/.storybook",
        "tsConfig": "apps/filecab/shared/.storybook/tsconfig.json",
        "styles": ["apps/filecab/shared/.storybook/global.scss"],
        "compodoc": false,
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "outputDir": "dist/storybook/filecab-popup",
        "sourceMap": false,
        "assets": [
          {
            "glob": "*.svg",
            "input": "apps/filecab/shared/popup-add-item/components/founded-item/images",
            "output": "assets/popup-add-item"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/filecab/popup", "apps/filecab-popup/**/*.ts", "apps/filecab-popup/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/filecab/popup/jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "apps/filecab/popup/tsconfig.spec.json"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
