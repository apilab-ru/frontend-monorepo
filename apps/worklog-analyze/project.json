{
  "name": "worklog-analyze",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/worklog-analyze/src",
  "prefix": "utils-monorep",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/worklog-analyze",
          "browser": ""
        },
        "index": "apps/worklog-analyze/src/index.html",
        "polyfills": [],
        "tsConfig": "apps/worklog-analyze/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/worklog-analyze/src/favicon.ico",
          "apps/worklog-analyze/src/assets",
          "apps/worklog-analyze/src/.htaccess"
        ],
        "styles": ["apps/worklog-analyze/src/styles.scss"],
        "scripts": [],
        "webWorkerTsConfig": "apps/worklog-analyze/tsconfig.worker.json",
        "browser": "apps/worklog-analyze/src/main.ts",
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "options": {
        "allowedHosts": true
      },
      "configurations": {
        "production": {
          "buildTarget": "worklog-analyze:build:production"
        },
        "development": {
          "buildTarget": "worklog-analyze:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "worklog-analyze:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
