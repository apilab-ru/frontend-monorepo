{
  "name": "filecab-ui-kit",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/filecab/ui-kit/src",
  "prefix": "filecab",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/filecab/ui-kit/.storybook",
        "browserTarget": "filecab-ui-kit:build-storybook",
        "compodoc": false,
        "styles": ["libs/filecab/ui-kit/.storybook/global.scss"],
        "tsConfig": "libs/filecab/ui-kit/.storybook/tsconfig.json",
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "sourceMap": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/filecab-ui-kit",
        "configDir": "libs/filecab/ui-kit/.storybook",
        "browserTarget": "filecab-ui-kit:build-storybook",
        "compodoc": false,
        "tsConfig": "libs/filecab/ui-kit/.storybook/tsconfig.json",
        "stylePreprocessorOptions": {
          "includePaths": ["."]
        },
        "styles": ["libs/filecab/ui-kit/.storybook/global.scss"],
        "sourceMap": false
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
